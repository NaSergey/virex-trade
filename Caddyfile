# Единственная точка входа снаружи: терминирует TLS (сертификат Let's Encrypt
# Caddy получает и продлевает сам) и проксирует всё на Next.
#
# Здесь же начинается цепочка X-Forwarded-For, на которую опирается лимит
# запросов в API: Caddy дописывает в заголовок адрес соединения, поэтому
# подделанное браузером значение оказывается левее и в расчёт не идёт. Отсюда
# TRUST_PROXY_HOPS=1 у api — см. backend/src/main.ts.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Host пробрасывается исходный, а X-Forwarded-For дополняется адресом
	# соединения — обоего поведения по умолчанию здесь достаточно.
	reverse_proxy web:8090
}
