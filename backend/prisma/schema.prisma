// Prisma schema for virex-trader backend
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // bcrypt hash
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Версия данных пользователя (T10, backend-optimization): растёт при любой
  // правке того, что видят агрегаты сделок (stats/list/lab/habits/...) — новые
  // сделки, теги, пересчёт рыночного контекста. Ключ LRU-кэша агрегатов и ETag
  // строятся по ней, поэтому инкремент атомарный (`SET x = x + 1` в SQL, см.
  // DataVersionService), не read-modify-write — конкурентные бампы не должны
  // теряться. См. docs/.../2026-09-16-backend-optimization/task-10-report.md.
  dataVersion Int @default(0)

  // Кто привёл этого пользователя — id из ссылки `/login?mode=register&ref=<id>`.
  // SetNull, а не Cascade: удаление аккаунта пригласившего не должно каскадом
  // утаскивать тех, кого он привёл, — они просто теряют ссылку на источник.
  invitedById  String?
  invitedBy    User?   @relation("Referrals", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[]  @relation("Referrals")

  // Кастомное имя для реферальной ссылки вместо userId — необязательное и
  // уникальное. Формат (латиница, цифры, дефис, 3–30 символов) проверяет DTO
  // (см. referrals/dto/referral-slug.dto.ts), здесь только колонка.
  referralSlug String? @unique

  // DEPRECATED — superseded by ExchangeConnection, kept only so
  // LegacyCredentialsMigrationService can move existing keys into the new table
  // on boot. Dropping them in the same change would have `prisma db push`
  // delete the columns before the app ever runs, taking the credentials with
  // them; they are nulled out once migrated and removed in a follow-up.
  bybitApiKeyEnc    String?
  bybitApiSecretEnc String?
  bybitConnectedAt  DateTime?

  // Which connected exchange drives sync, positions and trading right now.
  // Null until the first exchange is connected.
  activeExchange String?

  exchangeConnections ExchangeConnection[]

  // Telegram notifications: chat linked via the bot's /start <code> deep link
  // (TelegramService). Code is one-time — cleared on successful link — and
  // expires (see TELEGRAM_LINK_CODE_TTL_MS) so a link URL that leaks out of a
  // chat log can't be redeemed months later.
  // chatId is unique: a chat drives exactly one account, so an inbound button
  // press resolves to one user instead of an arbitrary findFirst match.
  telegramChatId     String?   @unique
  telegramLinkCode   String?   @unique
  telegramLinkCodeAt DateTime?

  /// Отклонения от дефолтов реестра уведомлений (см. notifications/registry.ts).
  /// JSON, а не таблица: настроек дюжина, читаются всегда целиком и никогда не
  /// участвуют в выборках, а строки на пользователя стоили бы миграции на
  /// каждый новый сигнал.
  notifyPrefs Json?

  notificationStates NotificationState[]

  activityMinutes    UserActivityMinute[]
  sectionDays        UserSectionDay[]
  refreshTokens      RefreshToken[]
  trades             Trade[]
  executions         Execution[]
  fundingFees        FundingFee[]
  tags               Tag[]
  positionTags       PositionTag[]
  openPositionsSeen  OpenPositionSeen[]
  savedTagCombos     SavedTagCombo[]
  dismissedTagCombos DismissedTagCombo[]
  balanceSnapshots   BalanceSnapshot[]
  donations          Donation[]
  backtestSessions   BacktestSession[]
  tournamentsCreated Tournament[]            @relation("TournamentCreator")
  tournamentEntries  TournamentParticipant[]

  /// Столы покера/блэкджека, которые я создал, и места, которые я занимаю.
  /// GameSeat живёт, только пока я сижу, — это не история, а текущее место.
  gameTablesCreated GameTable[] @relation("GameTableCreator")
  gameSeats         GameSeat[]

  /// Внутренняя валюта («монеты»): взносы в турниры, призы, покупка донатом.
  /// Стартовые 1000 — дефолт колонки, а не строка в register: так их получают и
  /// уже заведённые аккаунты при `db push`, и новый — без шага, который можно
  /// забыть. Журнал (CoinTransaction) ведётся от этой отметки, поэтому на
  /// старте он пуст, а баланс уже 1000.
  coinBalance      Int               @default(1000)
  coinTransactions CoinTransaction[]

  @@map("users")
}

/// Журнал движения монет — append-only, по строке на событие.
///
/// Баланс живёт колонкой на User, а не суммой этих строк: списание взноса —
/// compare-and-set по колонке (`coinBalance >= n` в том же UPDATE), и без него
/// два одновременных входа увели бы баланс в минус. Журнал нужен, чтобы «откуда
/// взялось» имело ответ, и чтобы уникальный ключ не дал начислить одно событие
/// дважды.
model CoinTransaction {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Со знаком: покупка и приз — плюс, взнос и добавка в фонд — минус,
  /// возврат — плюс.
  delta        Int
  /// Баланс после этой строки — чтобы историю можно было читать, не пересчитывая.
  balanceAfter Int
  /// 'DONATION' | 'TOURNAMENT_FEE' | 'TOURNAMENT_BONUS' | 'TOURNAMENT_REFUND' | 'TOURNAMENT_PRIZE'
  kind         String
  /// Откуда строка: id доната; id турнира — добавка в фонд и приз;
  /// `<id турнира>:<joinedAt в мс>` — взнос и его возврат, то есть одно участие
  /// (вышел и вошёл снова — новое участие и новая пара строк);
  /// `<id турнира>:bonus` — возврат добавки при удалении лобби.
  refId        String
  createdAt    DateTime @default(now())

  /// Одно событие — одна строка: повторный зачёт того же доната, приза или
  /// возврата упирается в ключ, а не в аккуратность вызывающего кода.
  @@unique([userId, kind, refId], map: "coin_tx_once")
  @@index([userId, createdAt])
  @@map("coin_transactions")
}

// One exchange account the user has connected. A user may hold several (one
// row per exchange) while exactly one — User.activeExchange — is the account
// the app reads and trades on.
//
// Secrets are AES-256-GCM encrypted at rest, same as before; they simply live
// per connection now instead of in columns on `users`. `passphraseEnc` is the
// third secret that OKX, Bitget and KuCoin require and Bybit does not — null
// for exchanges whose catalog entry sets needsPassphrase = false.
model ExchangeConnection {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange      String // ExchangeId — 'bybit', ...
  apiKeyEnc     String
  apiSecretEnc  String
  passphraseEnc String?
  connectedAt   DateTime @default(now())

  @@unique([userId, exchange])
  @@map("exchange_connections")
}

// One closed trade synced from an exchange (realized PnL).
// Source: GET /v5/position/closed-pnl. We store the key fields for stats plus the
// full raw record for forward-compat. Deduped on (orderId, closedAt) so re-syncs
// are idempotent. `direction` is the position side (closing Sell => was long).
model Trade {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol        String
  side          String // closing order side from Bybit: "Buy" | "Sell"
  direction     String // derived position side: "long" | "short"
  qty           Float
  avgEntryPrice Float
  avgExitPrice  Float
  closedPnl     Float
  openFee       Float     @default(0)
  closeFee      Float     @default(0)
  leverage      Float?
  /// Стоп, объявленный на входе: копируется из OpenPositionSeen при закрытии,
  /// ровно как openedAt. Null у сделки, чья позиция открылась при лежащем
  /// сервере, и у тех, кто держит стоп в голове, а не на бирже.
  stopLoss      Float?
  orderId       String
  closedAt      DateTime // Bybit updatedTime
  // Approximate position open time, copied from OpenPositionSeen when the
  // trade syncs. Null for trades whose position opened while the server was
  // down (or before this feature) — time-based stats simply skip those.
  openedAt      DateTime?
  // Groups the closing orders that belong to ONE position. Bybit's closed-pnl
  // emits a row per closing order, so taking profit in parts (or averaging in)
  // used to read as several separate trades — inflating the trade count and
  // the winrate. Derived from execution history: a position spans fills from
  // when size leaves 0 until it returns to 0 (see PositionBuilderService).
  // Null while the position hasn't been reconstructed yet — aggregates fall
  // back to treating such a row as its own position.
  positionId    String?
  raw           Json?
  // Which exchange this trade came from. Defaults to bybit so rows imported
  // before multi-exchange support keep their (only possible) origin.
  exchange      String    @default("bybit")
  createdAt     DateTime  @default(now())

  tags    TradeTag[]
  context TradeContext?
  risk    TradeRisk?

  @@unique([userId, exchange, orderId, closedAt])
  @@index([userId, symbol])
  @@index([userId, closedAt])
  @@index([userId, positionId])
  @@map("trades")
}

// One fill from Bybit's execution history (GET /v5/execution/list), stored so
// positions can be reconstructed without re-querying the exchange: closed-pnl
// alone never reveals the running position size, so it cannot tell a partial
// take-profit from a separate trade. Every execType that moves position size is
// kept (Trade, BustTrade/liquidations, AdlTrade, ...) — only "Funding" is
// dropped, which carries a qty as well and would corrupt the running size.
// `closedSize` is 0 on opening/averaging-in fills and > 0 on closing fills.
//
// Deduped on execId + orderId rather than execId alone: a self-cross reports
// both sides of the same fill under one execId with different orderIds, and
// keying on execId alone silently dropped one leg.
model Execution {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol     String
  side       String // "Buy" | "Sell"
  qty        Float
  price      Float
  closedSize Float
  execType   String // "Trade" | "BustTrade" | "AdlTrade" | ...
  orderId    String
  execId     String
  execTime   DateTime
  // Position reconstruction walks a user's whole fill history, so fills from
  // two different exchanges must never be replayed as one running size.
  exchange   String   @default("bybit")
  createdAt  DateTime @default(now())

  @@unique([userId, exchange, execId, orderId])
  @@index([userId, symbol, execTime])
  @@map("executions")
}

// One funding payment on a perpetual, kept out of Execution on purpose.
//
// Funding rows come back in the same execution history as fills and carry an
// execQty, so replaying them as fills drifts the running position size — which
// is why the adapters drop them from Fill. They are still real money: a
// position held across many funding windows pays (or earns) a sum that closed
// PnL never mentions, and the longer it is held the more of the result it
// explains. Storing them separately keeps position reconstruction honest and
// makes the cost of holding visible.
//
// `amount` follows the exchange's sign convention as paid-by-the-user: positive
// means the user paid, negative means the user received.
model FundingFee {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange String   @default("bybit")
  symbol   String
  amount   Float
  at       DateTime
  execId   String

  createdAt DateTime @default(now())

  @@unique([userId, exchange, execId])
  @@index([userId, symbol, at])
  @@map("funding_fees")
}

// User-defined entry-reason label ("пробой уровня", "отскок от EMA", ...).
// Attached to open positions via PositionTag and to closed trades via TradeTag;
// the stats page aggregates winrate/PnL per tag.
model Tag {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#6366f1")
  // Journal category: 'setup' (entry reason) | 'emotion' | 'mistake'.
  // Lets the stats page separate "which setups win" from "which mistakes cost me".
  type      String   @default("setup")
  createdAt DateTime @default(now())

  tradeTags    TradeTag[]
  positionTags PositionTag[]
  backtestTradeTags BacktestTradeTag[]

  @@unique([userId, name])
  @@map("tags")
}

model TradeTag {
  tradeId String
  tagId   String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
  @@map("trade_tags")
}

/// Сессия бектеста: случайный отрезок истории BTC, который пользователь крутит
/// вручную. Тренировочные сделки живут отдельно от журнала (Trade) — иначе
/// диагностика живой торговли считала бы сделки, которых не было на бирже.
model BacktestSession {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Точка старта; выбирает сервер, чтобы её нельзя было «перебросить» из браузера.
  startTime      DateTime
  /// Текущий момент сессии: время закрытия последней показанной минутки. Только растёт.
  cursorTime     DateTime
  startBalance   Float
  /// Текущий депозит сессии: стартовый плюс PnL закрытых сделок.
  balance        Float
  hideDate       Boolean
  hidePrice      Boolean
  /// Коэффициент показа цен; 1, если цена не скрыта. В базе цены настоящие.
  priceScale     Float
  /// Откуда свечи: 'real' — отрезок price_candles, 'synthetic' — рынок строит генератор (backtest/synthetic).
  dataSource     String    @default("real")
  /// Зерно генератора; только у synthetic.
  seed           Int?
  /// Версия генератора (SYNTH_VERSION), которой построена сессия; только у synthetic.
  synthVersion   Int?
  status         String    @default("active") // 'active' | 'finished'
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?
  /// Турнирная сессия: создаётся стартом турнира; в список и статистику бектеста не входит.
  tournamentId   String?
  tournament     Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Граница сессии: дальше неё ни свечей, ни сделок. Только у турнирных.
  endTime        DateTime?

  trades      BacktestTrade[]
  entryOrders BacktestEntryOrder[]

  @@unique([tournamentId, userId])
  @@index([userId, status])
  @@map("backtest_sessions")
}

/// Турнир: от 2 до 10 участников торгуют один график с одинаковым депозитом.
/// Участник получает обычную BacktestSession с tournamentId. История исполняется
/// браузером, как бектест; эфир — серверным движком (tournaments/tournament-runner).
model Tournament {
  id             String    @id @default(uuid())
  name           String
  /// Сейчас только 'live' — живой BTC. Колонка оставлена под режим 'history'
  /// (отрезок истории, каждый в своём темпе), который вынесен из первого этапа:
  /// второй режим тогда станет значением, а не миграцией.
  mode           String    @default("live")
  /// 'lobby' — набор участников; 'running' — идёт; 'finished' — итоги подведены.
  status         String    @default("lobby")
  /// 'public' — виден в общем списке, пока в лобби и есть места, войти может
  /// любой; 'private' — только по ссылке. Умолчание закрытое: публикация —
  /// осознанный выбор создателя.
  visibility     String    @default("private")
  startBalance   Float
  /// Число мест: 2–10. Два — дуэль.
  maxPlayers     Int       @default(10)
  /// Взнос каждого участника в монетах; 0 — бесплатный турнир.
  entryFee       Int       @default(0)
  /// Сколько монет создатель кладёт в призовой фонд сверх своего взноса.
  prizeBonus     Int       @default(0)
  /// Сколько мест получают приз и как делится фонд: проценты по местам, длина
  /// массива равна winnersCount, сумма 100, не возрастают. Призовой фонд —
  /// entryFee × участники + prizeBonus.
  winnersCount   Int       @default(1)
  payoutShares   Int[]     @default([100])
  /// От старта до конца, минуты: 60, 240, 1440, 4320, 10080.
  durationMin    Int
  /// SetNull: удаление аккаунта создателя не должно стирать идущий турнир у остальных.
  creatorId      String?
  creator        User?     @relation("TournamentCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  endsAt         DateTime?
  finishedAt     DateTime?
  /// Эфир: до какого момента движок уже проверил уровни открытых позиций.
  processedUntil DateTime?

  participants TournamentParticipant[]
  sessions     BacktestSession[]

  @@index([status, endsAt])
  /// Общий список открытых турниров: публичные лобби, новые сверху.
  @@index([visibility, status, createdAt])
  @@map("tournaments")
}

model TournamentParticipant {
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt     DateTime   @default(now())
  /// Итог турнира — проставляется финалом, один раз. Рейтинг игры считается
  /// агрегатом по этим колонкам, а не пересчётом сессий.
  finalEquity  Float?
  place        Int?
  /// Выплаченный приз в монетах; 0 у тех, кто не попал в число победителей.
  prizeWon     Int?

  @@id([tournamentId, userId])
  @@index([userId])
  @@map("tournament_participants")
}

/// Сделка бектеста. Открытая — это сделка с пустым exitTime; отдельной
/// «позиции» нет. Цены настоящие, без масштаба показа.
///
/// closedQty растёт с каждым частичным закрытием (BacktestTradeExit); когда
/// доходит до qty, сделка закрыта и exitTime/exitPrice/exitReason/fee/pnl/r
/// становятся агрегатом по всем строкам BacktestTradeExit, а не одним событием.
model BacktestTrade {
  id         String          @id @default(uuid())
  sessionId  String
  session    BacktestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  direction  String // 'long' | 'short'
  entryTime  DateTime
  entryPrice Float
  stopLoss   Float
  takeProfit Float?
  riskPct    Float
  riskUsdt   Float
  qty        Float
  /// Плечо, с которым сделка открыта; 1–100. Общее на сессию — меняется в любой момент
  /// через BacktestService.setLeverage и применяется сразу ко всем открытым сделкам
  /// (как на бирже: плечо задаётся на символ, не на отдельную позицию). @default(1) —
  /// только чтобы существующие строки могли мигрировать без ошибки NOT NULL; новые
  /// сделки всегда получают явное значение из DTO.
  leverage   Float           @default(1)
  /// Сколько уже закрыто частями (BacktestTradeExit.qty). qty - closedQty = остаток.
  closedQty  Float           @default(0)
  exitTime   DateTime?
  exitPrice  Float?
  exitReason String? // 'stop' | 'take' | 'manual' | 'finish' | 'limit'
  fee        Float?
  pnl        Float?
  r          Float?

  tags        BacktestTradeTag[]
  entries     BacktestTradeEntry[]
  exits       BacktestTradeExit[]
  closeOrders BacktestCloseOrder[]

  @@index([sessionId])
  @@map("backtest_trades")
}

/// Одно исполнение на вход — открытие сделки (openTrade) или добор сеткой
/// (addToTrade). Без этой истории entryPrice/entryTime сделки после доборов —
/// только усреднённый итог, и разметить на графике каждый отдельный вход
/// было нечем (см. BacktestTradeExit — тот же приём для частичных закрытий).
model BacktestTradeEntry {
  id      String        @id @default(uuid())
  tradeId String
  trade   BacktestTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  qty     Float
  price   Float
  time    DateTime
  /// Порядок вставки — тот же приём, что у BacktestTradeExit.createdAt.
  createdAt DateTime    @default(now())

  @@index([tradeId])
  @@map("backtest_trade_entries")
}

/// Одно частичное или финальное закрытие открытой сделки.
model BacktestTradeExit {
  id        String        @id @default(uuid())
  tradeId   String
  trade     BacktestTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  qty       Float
  price     Float
  time      DateTime
  reason    String // 'stop' | 'take' | 'manual' | 'finish' | 'limit'
  fee       Float
  pnl       Float
  /// Порядок вставки — по нему находим «последнее» закрытие при разборе
  /// повтора запроса (time — симулированное время в бектесте, не для этого).
  createdAt DateTime      @default(now())

  @@index([tradeId])
  @@map("backtest_trade_exits")
}

/// Висящий лимитный ордер на (частичное) закрытие. Живёт до срабатывания цены
/// в реплее или ручной отмены; на одну сделку может висеть несколько сразу.
model BacktestCloseOrder {
  id        String        @id @default(uuid())
  tradeId   String
  trade     BacktestTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  price     Float
  qty       Float
  createdAt DateTime      @default(now())

  @@index([tradeId])
  @@map("backtest_close_orders")
}

/// Уровень сетки на вход (Scaled order) — висит до касания цены в реплее или
/// ручной отмены. Привязан к сессии, не к сделке: до первого срабатывания
/// сделки ещё нет (её создаёт первый исполнившийся уровень, дальше — доборы).
/// stopLoss/takeProfit/leverage одинаковы у всех уровней одной сетки —
/// отдельной сущности «сетка» нет, значения просто продублированы по строкам.
model BacktestEntryOrder {
  id         String          @id @default(uuid())
  sessionId  String
  session    BacktestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  direction  String // 'long' | 'short'
  price      Float
  riskPct    Float
  stopLoss   Float
  takeProfit Float?
  leverage   Float
  createdAt  DateTime        @default(now())

  @@index([sessionId])
  @@map("backtest_entry_orders")
}

/// Теги на сделках бектеста. Устроено как TradeTag, но отдельной таблицей:
/// тренировочные сделки не должны попасть в статистику тегов живой торговли.
model BacktestTradeTag {
  tradeId String
  tagId   String
  trade   BacktestTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tag     Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
  @@map("backtest_trade_tags")
}

// Market-context snapshot of a closed trade, computed once from Bybit klines
// by TradeContextService (никаких live-запросов при фильтрации в «Лаборатории»).
// The snapshot is anchored at the trade's entry moment when we know it
// (Trade.openedAt), else at closedAt — `basis` records which one, so the lab
// can tell exact entries from approximations. `ok=false` marks trades whose
// kline history was insufficient (row still written so we don't retry forever);
// indicator fields stay null in that case.
model TradeContext {
  id      String  @id @default(uuid())
  tradeId String  @unique
  trade   Trade   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  basis   String // 'opened' | 'closed' — which trade timestamp anchored the snapshot
  ok      Boolean @default(true)

  // 1h timeframe at the anchor moment
  price         Float? // last 1h close before entry
  atrPct        Float? // ATR14 / price * 100 — volatility, comparable across symbols
  rsi           Float? // RSI14
  volRel        Float? // last candle volume / SMA20 volume (1 = average)
  ema200Above   Boolean? // price above EMA200
  ema200DistPct Float? // (price - EMA200) / EMA200 * 100
  // 4h regime from IndicatorsService.computeSnapshot: EMA20 vs EMA50 gated by ADX
  trend4h       String? // 'trend_up' | 'trend_down' | 'range'

  // Where the entry price sat inside the recent range of each timeframe:
  // (entry - low) / (high - low) * 100 over the last N candles closed before
  // the anchor. 0 = bought at the bottom of the range, 100 = at the top.
  // Deliberately NOT clamped: an entry above the range (breakout) reads > 100
  // and below it < 0, which is exactly what we want to be able to see.
  // Each window is exactly what the range-check chart of that timeframe draws
  // (48 candles on everything up to 1h, 60 on 4h and daily) — twelve hours on
  // 15m, a day on 30m, two days on 1h, ten days on 4h, two months on the daily.
  rangePos15m Float?
  rangePos30m Float?
  rangePos1h  Float?
  rangePos4h  Float?
  rangePos1d  Float?

  /// Качество входа/выхода относительно диапазона самой сделки (вход→выход),
  /// не относительно истории до входа, как rangePos. 0..100, клампится.
  /// null — меньше QUALITY_MIN_CANDLES свечей в окне сделки.
  entryQuality    Float?
  exitQuality     Float?
  /// true — попытка расчёта уже была (успешная или нет). Отличает «посчитан
  /// null, потому что данных мало» от «ещё не пытались» — без этого пустые
  /// пересчитывались бы на каждом тике синка.
  qualityComputed Boolean @default(false)

  // Field-set version of the snapshot. Snapshots are only ever computed for
  // trades that have none (context == null), so without this a newly added
  // indicator would stay null forever on every already-computed trade —
  // TradeContextService drops stale-version rows so they get recomputed.
  ctxVersion Int @default(1)

  computedAt DateTime @default(now())

  @@map("trade_contexts")
}

// Tags the user put on a currently open position (keyed by symbol+direction —
// Bybit allows at most one open position per key, so the pair identifies
// "the current position" for as long as it stays open). TradeSyncService
// copies them onto every closed trade of that position (closedAt >= createdAt),
// so ladder/partial closes all inherit the tags, then prunes the rows once
// the position is no longer open on Bybit (TagsService.pruneClosedPositions) —
// otherwise they'd leak onto the next position opened on the same symbol+direction.
model PositionTag {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  direction String // 'long' | 'short'
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, symbol, direction, tagId])
  @@index([userId, symbol, direction])
  @@map("position_tags")
}

// A user-composed tag combination pinned in «Лучшие комбинации»: unlike the
// auto-derived exact sets, a saved combo counts every trade CONTAINING all of
// its tags (whatever else is tagged) — a persistent strategy watchlist card.
model SavedTagCombo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagIds    String[] // 2+ tag ids, sorted; rows self-heal away if a tag is deleted
  key       String // sorted tagIds joined '|' — dedup handle
  // Unpinning must not delete a user-created card (recreating the exact same
  // trades/tags at 0-trade combos looked like data loss). Unpin just flips
  // this to false; the row (and its edit history via tagIds) stays put. Only
  // the explicit "Удалить" action hard-deletes the row.
  pinned    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@map("saved_tag_combos")
}

// A user-dismissed auto-derived combo card (exact tag set) — hides it from the
// "по тегам" combo grid going forward. Unlike SavedTagCombo this carries no
// tagIds, just the same canonical dedup key (sorted tag ids joined '|', or
// '__untagged__'): dismissing only needs to match, never to render tag names.
model DismissedTagCombo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@map("dismissed_tag_combos")
}

// First time the sync loop saw a position open on Bybit (±1 sync interval).
// Same lifecycle as PositionTag: upserted while the position is open, copied
// onto its closed trades as Trade.openedAt when they sync, pruned once the
// position is gone so it can't leak onto the next position on the same
// symbol+direction. Bybit's closed-pnl records carry no entry time and the
// position list's createdTime doesn't reset per position lifecycle, so our
// own first-seen clock is the reliable source here.
model OpenPositionSeen {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  direction   String // 'long' | 'short'
  firstSeenAt DateTime @default(now())

  // Entry snapshot taken the first tick the position was seen — same fields and
  // same formulas as TradeContext, but measured live at the entry instead of
  // reconstructed from history once the trade closes. Lets the открытая позиция
  // show its own entry context (в верхнем или нижнем диапазоне вошли) while
  // it's still running. Null until the snapshot succeeds; ctxOk=false marks a
  // symbol whose kline history was too short, so we stop retrying it.
  entryPrice    Float?
  /// Стоп на первом тике жизни позиции. Снимается там же и тогда же, где
  /// entryPrice: передвинутый позже трал не должен подменять намерение,
  /// объявленное на входе.
  stopLoss      Float?
  ctxOk         Boolean?
  ctxComputedAt DateTime?
  price         Float?
  atrPct        Float?
  rsi           Float?
  volRel        Float?
  ema200Above   Boolean?
  ema200DistPct Float?
  trend4h       String?
  rangePos15m   Float?
  rangePos30m   Float?
  rangePos1h    Float?
  rangePos4h    Float?
  rangePos1d    Float?

  @@unique([userId, symbol, direction])
  @@map("open_positions_seen")
}

/// Свечи BTC для графика и бектеста — единственный источник цены в проекте.
/// Владелец таблицы — MarketDataService; напрямую в неё не ходит больше никто,
/// кроме `scripts/volatile-hour-preview.ts` — тот поднимает свой PrismaClient
/// вне Nest DI и обращается к таблице напрямую законно, это не недосмотр.
model PriceCandle {
  symbol    String // 'BTCUSDT'
  timeframe Int // длительность свечи в МИНУТАХ: 1, 5, 15, 60, 240, 1440
  time      DateTime // время ОТКРЫТИЯ свечи, UTC
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float

  // Составной первичный ключ вместо uuid: на ~5.9 млн строк суррогатный ключ
  // стоил бы ~220 МБ данных плюс собственный индекс ~265 МБ ради колонки, к
  // которой никто не обращается — свечу адресуют символом, таймфреймом и
  // временем. Этот же ключ и есть индекс диапазонного чтения, и он же
  // запрещает дубли.
  @@id([symbol, timeframe, time])
  @@map("price_candles")
}

/// Периодический снимок «центра тяжести» книги заявок: средневзвешенная по
/// объёму цена бид- и аск-стороны (топ-200 уровней), рядом с ценой в тот
/// момент. Не сам стакан — тот занял бы сотни МБ в день на один символ, а его
/// сжатие до двух чисел. LiquiditySnapshotService пишет строку раз в 15 минут
/// для BTC/ETH/SOL; истории до первого запуска сервиса нет и не будет —
/// биржи не архивируют прошлые состояния стакана, поэтому бэкфилл здесь
/// невозможен в принципе, а не просто не сделан.
model LiquiditySnapshot {
  id        String   @id @default(uuid())
  symbol    String
  ts        DateTime
  price     Float
  bidCenter Float
  askCenter Float

  @@index([symbol, ts])
  @@map("liquidity_snapshots")
}

// One row per active refresh token (supports multiple devices / sessions).
// We never store the raw token — only its SHA-256 hash. On refresh the row is
// rotated (deleted + recreated in one transaction) so a stolen token is
// single-use and a failure mid-rotation can't drop a valid session.
// Rows are not self-cleaning: a session that is never refreshed or logged out
// leaves its row behind forever, so RefreshTokenCleanupService sweeps expired
// ones on an interval — hence the expiresAt index.
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Владельческая аналитика: пользуются ли сервисом вообще.
//
// Одна строка на пользователя и минуту, в которую сервер видел от него хотя бы
// один авторизованный запрос. Минута, а не отдельное событие на запрос: торговый
// UI опрашивает позиции каждые несколько секунд, и таблица событий росла бы
// сотнями тысяч строк в день, ничего не добавляя к ответу на вопрос «заходил ли
// человек и сколько раз».
//
// Минута здесь — единица засечки, а не единица отчёта: наружу отдаются ВИЗИТЫ
// (цепочки минут с разрывом меньше VISIT_GAP_MIN) и число обращений, но не
// время на сайте. Время с открытым приложением слишком легко прочитать как
// время человека за экраном — фоновая вкладка опрашивает API сама, — поэтому
// такого числа в отчёте нет вовсе.
//
// `requests` — все запросы за минуту, `writes` — только изменяющие (не GET).
// Разница важна: открытая вкладка сама по себе генерирует GET-ы, а write
// означает, что человек действительно что-то сделал.
// T18 (docs/superpowers/sdd/2026-09-16-backend-optimization/task-18-brief.md):
// составной первичный ключ вместо суррогатного `id uuid` — тот же приём и то
// же обоснование, что у `PriceCandle` (:556). Строка адресуется парой
// (userId, minute), к самому `id` никто не обращается, а на самой быстрорастущей
// таблице продукта (до сотен млн строк/год) это минус 37 байт и минус целый
// индекс на вставку. Владелец согласился на разовую потерю таблицы на проде
// при выкладке (`prisma db push --accept-data-loss`, данные аналитические и
// невосстановимые) — см. docs/deploy/user-activity-retention.md.
// Строки не живут вечно: UsageCleanupService сметает всё старше
// ACTIVITY_RETENTION_DAYS (usage/visits.ts), поэтому таблица не растёт без
// границ несмотря на отсутствие срока жизни у самой модели в схеме.
model UserActivityMinute {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minute   DateTime // UTC, обрезано до минуты
  requests Int      @default(0)
  writes   Int      @default(0)

  @@id([userId, minute])
  @@index([minute])
  @@map("user_activity_minutes")
}

// Какими разделами пользуются, по дням: сколько обращений и сколько из них
// были действиями. Времени здесь нет по той же причине, что и выше.
//
// T18: составной ключ вместо `id uuid`, тот же приём, что у UserActivityMinute
// выше — строка адресуется тройкой (userId, day, section), и это же — срез,
// по которому её ищут. Тоже под сроком жизни ACTIVITY_RETENTION_DAYS
// (см. UsageCleanupService).
model UserSectionDay {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day      DateTime // UTC-сутки, 00:00
  section  String // см. src/admin/usage/sections.ts
  requests Int      @default(0)
  writes   Int      @default(0)

  @@id([userId, day, section])
  @@index([day])
  @@map("user_section_days")
}

/// Якорь ряда баланса. Снимки не образуют сам ряд — баланс в произвольный
/// момент выводится из цепочки сделок относительно ближайшего якоря. Якоря
/// нужны, чтобы ловить снос вывода и обнаруживать ввод и вывод средств.
model BalanceSnapshot {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange String
  at       DateTime
  balance  Float
  /// 'snapshot' — спросили биржу, 'derived' — вывели из цепочки PnL.
  source   String
  /// Неторговое изменение баланса: положительное — ввод, отрицательное —
  /// вывод. Null, пока расхождения нет. Цепочка вывода через разрыв не
  /// продолжается, поэтому одно пополнение не искажает весь ряд назад.
  gap      Float?

  @@unique([userId, exchange, at])
  @@map("balance_snapshots")
}

/// Метрики риска одной сделки, посчитанные один раз. Материализуется дорогая
/// и стабильная часть — сопоставить сделке баланс на момент входа; сравнение
/// с порогом правила остаётся на чтение, чтобы правило можно было править без
/// пересчёта истории. Образец — TradeContext: та же версия набора полей и то
/// же правило «считаем только тем, у кого ещё нет».
model TradeRisk {
  id             String   @id @default(uuid())
  tradeId        String   @unique
  trade          Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  balanceAtEntry Float?
  /// 'snapshot' | 'derived' — доезжает до интерфейса: расчётные числа
  /// подписываются как оценка, а не выдаются за факт.
  balanceSource  String?
  exposurePct    Float?
  /// Null у сделки без стопа. Отдельно от ok=false: баланс известен,
  /// exposurePct посчитан, не хватает только стопа.
  plannedRiskPct Float?
  /// false — баланс на тот момент неизвестен. Такая сделка выпадает и из
  /// числителя, и из знаменателя доли соблюдения.
  ok             Boolean  @default(true)
  riskVersion    Int      @default(1)
  computedAt     DateTime @default(now())

  @@map("trade_risks")
}

/// Состояние одного сигнала у одного пользователя. Сигналы шлются по фронту
/// нарастания, и держать этот фронт в памяти процесса нельзя: перезапуск api
/// означал бы повторную рассылку всем сразу — ровно то, что делал
/// VolatilityAlertService своими двумя булевыми полями на всех пользователей.
model NotificationState {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// NotifKey из реестра.
  key    String
  /// Не null, пока условие держится. Обнуляется, когда метрика вернулась под
  /// порог, — тогда следующий всплеск снова считается событием.
  activeSince DateTime?
  lastSentAt  DateTime?

  @@unique([userId, key])
  @@map("notification_states")
}

// ─────────────────────────────────────────────────────────────────────────────
// Донаты разработчику: USDT в сети TRON (TRC20) на ОДИН общий кошелёк проекта.
//
// Отдельного кошелька на пользователя здесь нет намеренно: перевод USDT-TRC20
// стоит энергии/TRX, и деньги, собранные на сотне временных адресов, пришлось
// бы сводить на основной за собственный счёт. Все переводы идут прямо на один
// адрес, а платёж узнаётся не по адресу и не по порядку прихода, а по СУММЕ:
// каждому интенту выдаётся собственный «хвост» в младших знаках
// (5.00 → 5.0043), и пока интент жив, эта сумма занята только им.
// Уникальность хвоста держит не проверка в коде, а строка в
// `donation_amount_locks` с первичным ключом по сумме: два одновременных
// запроса на 5 USDT не могут получить одинаковый хвост даже в гонке — второй
// упрётся в нарушение уникальности и возьмёт другой.
//
// Деньги хранятся в МИНИМАЛЬНЫХ ЕДИНИЦАХ (BigInt, 6 знаков — decimals USDT в
// TRON), а не во Float, как остальные суммы в этой схеме. Сопоставление здесь
// строится на точном равенстве сумм, а Float даёт 5.0137 != 5.0137 на ровном
// месте — единственное место продукта, где это критично.
model Donation {
  id     String  @id @default(uuid())
  // Аноним допустим: кнопка «Поддержать» может стоять и на публичной странице.
  // При удалении аккаунта запись остаётся, но теряет владельца — деньги
  // пришли, и строка о них не должна исчезать вместе с профилем.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // PENDING | PAID | EXPIRED | CANCELED (см. donations/donation-status.ts)
  status           String @default("PENDING")
  currency         String @default("USDT")
  network          String @default("TRC20")
  receivingAddress String

  /// Сколько человек попросил заплатить (5 USDT → 5_000_000).
  requestedUnits BigInt
  /// Сколько он должен перевести с уникальным хвостом (5_004_300).
  expectedUnits  BigInt
  /// Сколько реально пришло. Совпадает с expectedUnits: частичные и избыточные
  /// платежи автоматически не засчитываются (см. TronIncomingTransfer).
  paidUnits      BigInt?

  /// Хеш транзакции TRON. Unique — вторая половина защиты от двойного зачёта:
  /// даже если одну и ту же транзакцию обработают два процесса, засчитается
  /// она ровно одному интенту.
  transactionHash String?   @unique
  fromAddress     String?
  /// block_timestamp транзакции — когда деньги ушли по мнению сети.
  transferredAt   DateTime?
  /// Когда её увидел наш опрашивающий сервис. Отличается от transferredAt на
  /// время финализации блока плюс период опроса.
  detectedAt      DateTime?
  /// Платёж доехал после истечения окна: человек заплатил в срок, но блок
  /// финализировался позже. Деньги засчитаны, благодарность — с оговоркой.
  paidAfterExpiry Boolean   @default(false)
  notifiedAt      DateTime?

  /// Необязательная подпись доната. В сети её нет и быть не может (memo в
  /// TRC20-переводе не доезжает) — это то, что человек написал в форме.
  note String?

  /// 10 минут — окно, которое видит пользователь.
  expiresAt  DateTime
  /// До какого момента сумма остаётся закреплённой за интентом. Больше
  /// expiresAt: транзакция, отправленная на последней минуте, становится
  /// необратимой уже после неё, и без запаса такие деньги повисли бы ничьими.
  matchUntil DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  amountLock DonationAmountLock?
  transfer   TronIncomingTransfer?

  @@index([status, expiresAt])
  @@index([status, matchUntil])
  @@index([userId, createdAt])
  @@map("donations")
}

/// Занятая сумма. Первичный ключ — сама сумма в минимальных единицах: пока
/// строка жива, ни один другой интент не может получить тот же хвост, и
/// сопоставление перевода с интентом остаётся однозначным. Строка снимается
/// при оплате, отмене и по истечении matchUntil.
model DonationAmountLock {
  expectedUnits BigInt   @id
  donationId    String   @unique
  donation      Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  heldUntil     DateTime
  createdAt     DateTime @default(now())

  @@index([heldUntil])
  @@map("donation_amount_locks")
}

/// Журнал ВСЕХ входящих USDT-переводов на кошелёк проекта — и опознанных, и
/// нет. Существует ради двух вещей: идемпотентности (уникальный ключ не даёт
/// обработать один перевод дважды, сколько бы раз опрос его ни увидел) и
/// сверки — деньги, не подошедшие ни одному интенту, должны быть видны, а не
/// молча потеряны в логах.
///
/// Ключ дедупа — (txId, from, valueUnits), а не один txId: одна транзакция
/// теоретически может нести несколько Transfer-логов. Обратная сторона — два
/// одинаковых перевода от одного отправителя внутри ОДНОЙ транзакции сочтутся
/// за один; случай экзотический (батч-контракт), деньги при этом никуда не
/// деваются и зачисляются вручную по этому же журналу.
model TronIncomingTransfer {
  id              String    @id @default(uuid())
  txId            String
  fromAddress     String
  toAddress       String
  contractAddress String
  valueUnits      BigInt
  blockTimestamp  DateTime
  /// NEW — принят, ещё не разобран (упадём после вставки — вернёмся к нему);
  /// MATCHED — засчитан интенту; UNMATCHED — сумма не соответствует ни одному
  /// живому интенту (ручная сверка); DUPLICATE_TX — этот хеш уже засчитан.
  status          String    @default("NEW")
  donationId      String?   @unique
  donation        Donation? @relation(fields: [donationId], references: [id], onDelete: SetNull)
  raw             Json?
  seenAt          DateTime  @default(now())
  processedAt     DateTime?

  @@unique([txId, fromAddress, valueUnits])
  @@index([status, blockTimestamp])
  @@map("tron_incoming_transfers")
}

/// Водяной знак опроса блокчейна: с какого block_timestamp спрашивать TronGrid
/// в следующий раз. Одна строка (id = 'usdt-trc20'). Хранится в БД, а не в
/// памяти: после перезапуска сервис обязан продолжить с того же места, иначе
/// платежи, пришедшие в минуту простоя, не увидит никто.
model TronScanCursor {
  id            String   @id
  lastScannedAt DateTime
  updatedAt     DateTime @updatedAt

  @@map("tron_scan_cursors")
}

/// Стол покера/блэкджека — общая инфраструктура обеих игр. Казино-логика
/// ставок, не турнирная: постоянный стол, на который садятся со своим buy-in
/// и с которого встают когда угодно, забирая остаток стека. Правила самой
/// раздачи (карты, ставки, вскрытие) здесь не живут — предмет отдельных
/// модулей поверх этого стола.
model GameTable {
  id         String     @id @default(uuid())
  /// "blackjack" | "poker" — строкой, как остальные статусы этой схемы:
  /// новый тип игры не требует миграции.
  gameType   String
  name       String
  /// 'public' — виден в общем списке, пока открыт; 'private' — только по
  /// ссылке. Умолчание закрытое: публикация — осознанный выбор создателя.
  visibility String     @default("private")
  /// 'open' — можно сесть; 'closed' — стола больше нет в лобби.
  status     String     @default("open")
  minBuyIn   Int
  maxBuyIn   Int
  maxSeats   Int
  /// SetNull: удаление аккаунта создателя не должно стирать стол у тех, кто
  /// за ним сидит.
  creatorId  String?
  creator    User?      @relation("GameTableCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  closedAt   DateTime?
  seats      GameSeat[]

  @@index([visibility, status, createdAt])
  @@map("game_tables")
}

/// Место за столом. Живёт, только пока игрок сидит — уход строку удаляет, а
/// не помечает статусом: история и так лосслесно лежит в CoinTransaction
/// (GAME_BUYIN/GAME_CASHOUT), а живая строка на выбывшего навсегда занимала
/// бы номер места под `@@unique([tableId, seatIndex])`.
model GameSeat {
  id        String    @id @default(uuid())
  tableId   String
  table     GameTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  seatIndex Int
  /// Стек фишек в монетах. Меняется игровой логикой раздач (вне этого
  /// сервиса); при посадке равен buy-in, при уходе целиком уходит в кэшаут.
  stack     Int
  joinedAt  DateTime  @default(now())

  @@unique([tableId, seatIndex])
  @@unique([tableId, userId])
  @@map("game_seats")
}
