# Server
PORT=8091
# Public address of the frontend. Also decides whether the session cookie
# is marked Secure — use https:// in any TLS deployment.
FRONTEND_URL=http://localhost:8090

# Database (PostgreSQL). In Docker, compose overrides the host with `db`.
DATABASE_URL=postgresql://virex:virex@localhost:5432/virex?schema=public

# Auth / JWT. Required in every environment: the server refuses to start
# without it, the same way it refuses without CREDENTIALS_ENCRYPTION_KEY.
# Left empty on purpose — a placeholder here used to be copied verbatim
# into deployments, and a token signed with a secret published in this
# repository can be forged by anyone for any user id.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Master key encrypting each user's Bybit API credentials at rest (per-user
# keys live in the DB, entered via the Settings page — not here).
# Required in every environment: the server refuses to start without a valid
# 64-char hex value. Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=


# Telegram bot token — optional. Powers trade-notification connect flow on
# the Statistics page. Without it, TelegramService disables itself (no
# polling, no sends) and everything else keeps working.
TELEGRAM_BOT_TOKEN=

# ─── Донаты в USDT-TRC20 ───────────────────────────────────────────────────
# Один общий кошелёк проекта, на который идут ВСЕ донаты. Пока он не задан,
# раздел «Поддержать разработчика» отвечает enabled:false, а опрос блокчейна
# не запускается — остальное приложение работает как прежде.
# Адрес проверяется по контрольной сумме base58check при старте: опечатка
# означает деньги, ушедшие в никуда, и узнать о ней из первого доната поздно.
DONATION_TRON_ADDRESS=

# Ключ TronGrid — необязательный, но желательный: без него публичный API режет
# по IP. Бесплатно заводится на trongrid.io.
TRONGRID_API_KEY=
# Основная сеть по умолчанию; для тестнета — https://nile.trongrid.io
TRONGRID_API_URL=https://api.trongrid.io
# Контракт USDT. Значение по умолчанию — основная сеть TRON; менять только
# ради тестнета, где у токена другой адрес.
# DONATION_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Окно оплаты (10 мин) и запас на позднее подтверждение блока (20 мин), мс.
# DONATION_TTL_MS=600000
# DONATION_LATE_GRACE_MS=1200000
# Период опроса блокчейна, мс.
# DONATION_POLL_INTERVAL_MS=15000
# Границы суммы, USDT.
# DONATION_MIN_AMOUNT=1
# DONATION_MAX_AMOUNT=10000
# Сколько неоплаченных окон разрешено одному пользователю.
# DONATION_MAX_PENDING_PER_USER=3
# 'address' (по умолчанию) — в QR только адрес; 'tron-uri' — ссылка tron: с
# суммой, которую понимает не каждый кошелёк.
# DONATION_QR_MODE=address
