# Server
PORT=8091
FRONTEND_URL=http://localhost:8090

# Database (PostgreSQL). In Docker, compose overrides the host with `db`.
DATABASE_URL=postgresql://virex:virex@localhost:5432/virex?schema=public

# Auth / JWT. The value below is a development placeholder: with
# NODE_ENV=production the server refuses to start unless it is replaced,
# since anyone could otherwise forge an access token for any user.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Master key encrypting each user's Bybit API credentials at rest (per-user
# keys live in the DB, entered via the Settings page — not here).
# Required in every environment: the server refuses to start without a valid
# 64-char hex value. Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=


# Telegram bot token — optional. Powers trade-notification connect flow on
# the Statistics page. Without it, TelegramService disables itself (no
# polling, no sends) and everything else keeps working.
TELEGRAM_BOT_TOKEN=

# Кому открыт раздел /api/admin/analytics — статистика по всем пользователям
# сервиса (почты, время на сайте, что открывали). Список почт через запятую.
# Пусто или не задано — админка закрыта для всех, включая владельца: право
# сюда даётся только через окружение сервера, а не через данные в БД.
ADMIN_EMAILS=
