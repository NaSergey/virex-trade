# HTTPS-вход в продукт. Caddy сам получает сертификат Let's Encrypt по
# домену из APP_DOMAIN и сам его продлевает — отдельного certbot и cron не
# нужно. Условие ровно одно: A-запись домена уже указывает на этот VPS, а
# порты 80 и 443 свободны (проверка ACME ходит на 80).
#
# Монтируется в контейнер caddy из docker-compose.prod.yml.

{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Весь трафик уходит в Next: он же отдаёт страницы и он же проксирует
	# /api/* и /auth/* в backend (rewrites в next.config.ts). Отдельного
	# правила для API здесь нет намеренно — браузер и backend обязаны жить
	# на одном origin, иначе кука сессии не доедет до proxy.ts.
	reverse_proxy web:8090

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# www — на тот же сайт редиректом, чтобы у продукта был один канонический
# адрес (иначе кука, поставленная на голом домене, на www не работает).
# Строку можно убрать, если www-записи в DNS нет.
www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}
