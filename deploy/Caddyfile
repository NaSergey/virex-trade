# HTTPS-вход в продукт. Caddy сам получает сертификат Let's Encrypt по
# имени из APP_DOMAIN и сам его продлевает — отдельного certbot и cron не
# нужно. Условие ровно одно: A-запись этого имени уже указывает на VPS, а
# порты 80 и 443 свободны (проверка ACME ходит на 80).
#
# APP_DOMAIN — полное имя сайта, обычно поддомен: app.example.com. Корень
# домена при этом живёт где угодно (хоть на Vercel) и сюда не относится.
#
# Монтируется в контейнер caddy из docker-compose.prod.yml.

{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# /api/* и /auth/* идут в api напрямую, минуя Next: тот же origin (тот
	# же домен, тот же порт наружу), только внутри сети compose запрос
	# больше не делает лишний хоп через Node-процесс, который в это же
	# время рендерит страницы (A10). Кука сессии (`refresh_token`,
	# `path: '/'`) от этого не страдает — origin для браузера один и тот же,
	# меняется только то, какой контейнер отвечает на префикс.
	#
	# `rewrites` в next.config.ts при этом остаются: они нужны локальному
	# запуску без Caddy (start.bat) и здесь просто не используются — до них
	# эти пути не доходят.
	handle /api/* {
		reverse_proxy api:8091
	}
	handle /auth/* {
		reverse_proxy api:8091
	}
	handle {
		reverse_proxy web:8090
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# Если продукт стоит на КОРНЕ домена (APP_DOMAIN=example.com), а не на
# поддомене, — добавить сюда редирект с www, чтобы адрес был один: кука
# сессии, поставленная на голом домене, на www не работает.
#
#	www.{$APP_DOMAIN} {
#		redir https://{$APP_DOMAIN}{uri} permanent
#	}
#
# Для поддомена этого блока быть не должно: имени www.app.example.com в DNS
# нет, и Caddy будет впустую ходить за сертификатом на него.
