# Значения для docker-compose.prod.yml. Скопировать в .env.prod и заполнить:
#   cp .env.prod.example .env.prod
# Файл .env.prod в гит не коммитится (см. .gitignore).

# Домен сайта. Caddy по нему получает сертификат, поэтому это должно быть
# реальное имя, указывающее A-записью на этот сервер.
SITE_ADDRESS=virex.example.com
# Тот же адрес со схемой — уходит в FRONTEND_URL бэкенда (CORS).
SITE_URL=https://virex.example.com

# PostgreSQL. Пароль — не «virex» из dev-компоуза: в базе лежат зашифрованные
# ключи бирж и вся история сделок.
POSTGRES_USER=virex
POSTGRES_PASSWORD=
POSTGRES_DB=virex

# openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Мастер-ключ шифрования ключей бирж, 64 hex-символа: openssl rand -hex 32
# Потеря значения означает, что все подключённые ключи придётся вводить заново.
CREDENTIALS_ENCRYPTION_KEY=

# Необязательный: без него TelegramService просто выключает себя.
TELEGRAM_BOT_TOKEN=

# Сколько пользователей синхронизировать одновременно. 24 хватает на тысячу
# подключённых при минутном интервале; поднимать имеет смысл, если в логах
# появилось предупреждение о затянувшемся обходе.
TRADE_SYNC_CONCURRENCY=24
