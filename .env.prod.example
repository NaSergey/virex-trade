# Конфигурация продакшен-стека на VPS (docker-compose.prod.yml).
#
#   cp .env.prod.example .env.prod   и заполнить значения ниже
#
# Файл .env.prod в git не попадает (см. .gitignore) и живёт только на
# сервере: в нём ключ, которым зашифрованы биржевые ключи пользователей.
# Права: chmod 600 .env.prod.

# Полное имя сайта — без схемы и без слэша. Обычно поддомен уже занятого
# домена: корень при этом остаётся там, где стоял. На это же имя Caddy
# получает сертификат. Если продукт ставится на корень домена — см.
# закомментированный блок про www в deploy/Caddyfile.
APP_DOMAIN=app.example.com

# Почта для Let's Encrypt: туда придёт письмо, если продление сертификата
# сломается. Реальная, не заглушка.
ACME_EMAIL=you@example.com

# --- база ---------------------------------------------------------------
# Наружу порт не публикуется, но пароль всё равно не «virex»: до базы
# дотягивается любой контейнер в той же сети.
# Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=
# Менять эти два уже после первого запуска нельзя — том с данными создан
# под старыми значениями.
POSTGRES_USER=virex
POSTGRES_DB=virex

# --- backend ------------------------------------------------------------
# Подпись access-токенов. С NODE_ENV=production сервер не стартует с
# дефолтной строкой-заглушкой.
# Сгенерировать: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Мастер-ключ, которым шифруются API-ключи бирж в базе. Ровно 64 hex-символа.
# Потерять его = потерять все подключения пользователей к биржам: ключи в
# базе останутся, но расшифровать их будет нечем.
# Сгенерировать: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# Токен телеграм-бота уведомлений. Необязателен: без него TelegramService
# сам себя выключает, остальное работает.
TELEGRAM_BOT_TOKEN=

# ── Донаты (необязательно) ────────────────────────────────────────────────
# Кошелёк проекта в сети TRON: адрес в base58check, начинается с T.
# Без него приём донатов выключается сам, остальное работает как обычно.
DONATION_TRON_ADDRESS=
# Ключ TronGrid — не обязателен, но желателен: без него публичный API режет
# по IP, а наблюдатель опрашивает сеть раз в 15 секунд. Заводится бесплатно.
TRONGRID_API_KEY=
